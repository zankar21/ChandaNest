{
  "name": "chandanest-api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed:public": "ts-node-dev --transpile-only -r dotenv/config scripts/seed-public.ts",
    "seed:public:media": "ts-node-dev --transpile-only -r dotenv/config scripts/seed-public-media.ts",
    "ops:projects:canonical-backfill": "node -r dotenv/config -r ts-node/register/transpile-only scripts/backfill-projects-canonical-truth.ts",
    "ops:monetization:reconcile": "node -r dotenv/config -r ts-node/register/transpile-only scripts/reconcile-monetization.ts",
    "ops:monetization:health": "node -r dotenv/config -r ts-node/register/transpile-only scripts/print-monetization-health.ts",
    "sanity:phase8": "node ./scripts/sanityPhase8.mjs",
    "auth:create-test-users": "node ./scripts/createTestUsers.mjs",
    "test": "node --test -r ts-node/register/transpile-only tests/**/*.test.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.6.0",
    "helmet": "^7.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/node": "^22.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
